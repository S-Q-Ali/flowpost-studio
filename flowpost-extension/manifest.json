{
  "name": "FlowPost Bridge",
  "description": "FlowPost extension for Facebook monetization tools.",
  "version": "1.0",
  "manifest_version": 3,
  "background": {
    "service_worker": "bg.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "declarativeNetRequest",
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.business.facebook.com/*",
    "*://localhost/*",
    "*://127.0.0.1/*"
  ]
}
