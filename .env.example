# Copy to .env and fill in your values.
# App password: set APP_PASSWORD in Supabase Dashboard → Project Settings → Edge Functions → Secrets (never in frontend).

# Groq API (for AI caption generation via generate-ai-captions edge function)
# Get your free API key at https://console.groq.com
# GROQ_API_KEY = gsk_...

# Supabase personal access token for the CLI (deploy, db push).
# Create one at https://supabase.com/dashboard/account/tokens — keep it in .env, never in a tracked file.
# ACCESS_TOKEN = sbp_...
