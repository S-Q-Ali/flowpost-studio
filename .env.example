# Dashboard (Vite). Copy this file to .env.local and fill in the values.
VITE_SUPABASE_URL =
VITE_SUPABASE_ANON_KEY =

# Groq API key for local work on the caption prompt (the function reads its
# own GROQ_API_KEY secret; never ship a key in the dashboard).
# GROQ_API_KEY = gsk_...

# Supabase personal access token for the CLI (deploy, db push).
# Create one at https://supabase.com/dashboard/account/tokens; keep the real
# value in .env (ignored), never in this file.
# ACCESS_TOKEN = sbp_...
