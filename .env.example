# FlowPost Studio — example environment. Copy to a real file and fill in values.
# NEVER commit a file that holds real values. This file ships with the
# repository and holds placeholders only.

# ---------------------------------------------------------------------------
# Web dashboard (Vite). Copy this file to .env.local and fill in these two.
# The browser talks to Supabase with the public anon key; the service-role key
# never reaches it.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL =
VITE_SUPABASE_ANON_KEY =

# Supabase personal access token for the CLI only (deploy, db push, secrets).
# Create one at https://supabase.com/dashboard/account/tokens. Keep the real
# value in .env (git-ignored); it is never used by the app or the dashboard.
# ACCESS_TOKEN = sbp_...

# ---------------------------------------------------------------------------
# Server-side secrets for the edge functions.
#
# In production set these with `npx supabase secrets set NAME=value` (or in
# Supabase Dashboard → Edge Functions → Secrets); for local `supabase functions
# serve`, keep them in the git-ignored .env. They are placeholders here only so
# the list is complete — uncomment into your local .env, never commit a value.
#
# A fresh operator does NOT have to set the second group by hand: the guided
# setup wizard on the desktop stores them in the server's `operator_config`
# table, encrypted, and the functions read stored-first / env-as-fallback
# (docs/adr/0005-server-held-secrets.md).
# ---------------------------------------------------------------------------

# --- Infrastructure: always env, never the wizard -------------------------
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=            # server-side DB access; never a client value
# ALLOWED_ORIGIN=                        # frontend origin allowed by CORS
# FRONTEND_API_KEY=                      # key the dashboard sends on function calls
# CRON_API_KEY=                          # key the scheduler sends
# TOKEN_ENCRYPTION_KEY=                  # base64 256-bit AES-GCM key; seals every stored value and platform token (see the runbook before rotating)
# LICENSE_PEPPER=                        # HMAC-SHA-256 key for the license digests; set before issuing the first key, then never change it (changing it invalidates every key issued)
# GOOGLE_SHEET_ID=                       # default sheet used by workflows

# --- The 18 keys the guided setup can store on the server -----------------
# AI captions
# GROQ_API_KEY=                          # gsk_...; transcription, vision, captions

# Media store (Cloudflare R2)
# R2_ENDPOINT=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

# Google / YouTube and Drive OAuth clients
# YT_CLIENT_ID=
# YT_CLIENT_SECRET=
# GD_CLIENT_ID=
# GD_CLIENT_SECRET=

# Meta apps (Instagram and Facebook)
# IG_APP_ID=
# IG_APP_SECRET=
# FB_APP_ID=
# FB_APP_SECRET=

# TikTok app
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# LinkedIn app
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
