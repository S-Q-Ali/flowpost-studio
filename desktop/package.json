{
  "name": "flowpost-desktop",
  "version": "1.0.0",
  "description": "FlowPost Desktop Application",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "npm run build:web && npm run build:electron",
    "build:web": "cd .. && npm run build",
    "build:electron": "tsc && electron-builder",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:electron\"",
    "dev:web": "cd .. && npm run dev",
    "dev:electron": "tsc && electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "keywords": [],
  "author": "FlowPost",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "concurrently": "^9.1.2",
    "electron": "^34.3.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
