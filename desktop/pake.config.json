{
  "$schema": "https://raw.githubusercontent.com/tw93/pake/main/schema/pake.schema.json",
  "url": "https://flowpost-studio.vercel.app",
  "name": "FlowPost",
  "identifier": "com.flowpost.desktop",
  "title": "FlowPost",
  "appVersion": "1.0.0",
  "width": 1440,
  "height": 900,
  "minWidth": 1024,
  "minHeight": 700,
  "showSystemTray": true,
  "hideOnClose": true,
  "startToTray": false,
  "newWindow": true,
  "multiWindow": true,
  "enableDragDrop": true,
  "enableFind": true,
  "passwordAutosave": true,
  "keepBinary": true,
  "darkMode": false,
  "alwaysOnTop": false,
  "maximize": false,
  "icon": "public/logo.png",
  // Desktop OAuth settings
  "userAgent": "FlowPost/1.0.0 (Desktop)",
  "inject": []
}
